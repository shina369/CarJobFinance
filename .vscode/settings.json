{
  "git.autofetch": true,
  "git.autorefresh": true,
  "git.confirmSync": false,
  "github.gitHelper.enabled": true,
  "editor.minimap.enabled": false,
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/build": true,
    "**/.flutter-plugins": true,
    "**/.flutter-plugins-dependencies": true,
    "**/.pub-cache": true
  },
  "search.exclude": {
    "**/build": true,
    "**/.dart_tool": true,
    "**/pubspec.lock": true
  }
}